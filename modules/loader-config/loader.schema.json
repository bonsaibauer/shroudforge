{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "logging",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "logging": {
      "type": "object",
      "required": [
        "minimumLevel"
      ],
      "properties": {
        "minimumLevel": {
          "enum": [
            "TRACE",
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR"
          ]
        }
      }
    },
    "exports": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "modloader": {
      "enum": [
        "eml",
        "shroudforge"
      ]
    },
    "catalog": {
      "type": "object",
      "properties": {
        "provider": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "baseUrl",
                "projectId",
                "loader"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "baseUrl": {
                  "type": "string",
                  "pattern": "^https://",
                  "maxLength": 2048
                },
                "projectId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "loader": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": [
        "actions",
        "parameters",
        "results"
      ],
      "properties": {
        "actions": {
          "type": "object",
          "required": [
            "diagnostics",
            "refresh",
            "refreshMod",
            "reloadSettings",
            "checkUpdates",
            "stageUpdate",
            "queueSystemUpdate",
            "selectUpdateQueueItems",
            "removeUpdateQueueItem",
            "startUpdateQueue",
            "clearUpdateQueue",
            "cancelUpdate",
            "restoreGamefiles",
            "captureGamefileOriginals",
            "searchCatalog",
            "installMod",
            "updateMod",
            "runModAction",
            "removeMod",
            "setNewsRead"
          ],
          "properties": {
            "diagnostics": {
              "type": "boolean"
            },
            "refresh": {
              "type": "boolean"
            },
            "refreshMod": {
              "type": "boolean"
            },
            "reloadSettings": {
              "type": "boolean"
            },
            "checkUpdates": {
              "type": "boolean"
            },
            "stageUpdate": {
              "type": "boolean"
            },
            "queueSystemUpdate": {
              "type": "boolean"
            },
            "selectUpdateQueueItems": {
              "type": "boolean"
            },
            "removeUpdateQueueItem": {
              "type": "boolean"
            },
            "startUpdateQueue": {
              "type": "boolean"
            },
            "clearUpdateQueue": {
              "type": "boolean"
            },
            "cancelUpdate": {
              "type": "boolean"
            },
            "restoreGamefiles": {
              "type": "boolean"
            },
            "captureGamefileOriginals": {
              "type": "boolean"
            },
            "searchCatalog": {
              "type": "boolean"
            },
            "installMod": {
              "type": "boolean"
            },
            "updateMod": {
              "type": "boolean"
            },
            "runModAction": {
              "type": "boolean"
            },
            "removeMod": {
              "type": "boolean"
            },
            "setNewsRead": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "parameters": {
          "type": "object",
          "required": [
            "diagnostics",
            "refresh",
            "refreshMod",
            "reloadSettings",
            "checkUpdates",
            "stageUpdate",
            "queueSystemUpdate",
            "selectUpdateQueueItems",
            "removeUpdateQueueItem",
            "startUpdateQueue",
            "clearUpdateQueue",
            "cancelUpdate",
            "restoreGamefiles",
            "captureGamefileOriginals",
            "searchCatalog",
            "installMod",
            "updateMod",
            "runModAction",
            "removeMod",
            "setNewsRead"
          ],
          "properties": {
            "diagnostics": {
              "type": "object",
              "properties": {
                "action": {
                  "enum": [
                    "start",
                    "stop",
                    "snapshot"
                  ]
                }
              },
              "additionalProperties": false
            },
            "refresh": {
              "type": "object",
              "maxProperties": 0
            },
            "refreshMod": {
              "type": "object",
              "required": [
                "modId"
              ],
              "properties": {
                "modId": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "additionalProperties": false
            },
            "reloadSettings": {
              "type": "object",
              "maxProperties": 0
            },
            "checkUpdates": {
              "type": "object",
              "maxProperties": 0
            },
            "stageUpdate": {
              "type": "object",
              "properties": {
                "waitForGame": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "queueSystemUpdate": {
              "type": "object",
              "maxProperties": 0
            },
            "selectUpdateQueueItems": {
              "type": "object",
              "required": [
                "ids",
                "selected"
              ],
              "properties": {
                "ids": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  }
                },
                "selected": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "removeUpdateQueueItem": {
              "type": "object",
              "required": [
                "key"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "additionalProperties": false
            },
            "startUpdateQueue": {
              "type": "object",
              "properties": {
                "ids": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  }
                },
                "waitForGame": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "clearUpdateQueue": {
              "type": "object",
              "maxProperties": 0
            },
            "cancelUpdate": {
              "type": "object",
              "maxProperties": 0
            },
            "restoreGamefiles": {
              "type": "object",
              "maxProperties": 0
            },
            "captureGamefileOriginals": {
              "type": "object",
              "maxProperties": 0
            },
            "searchCatalog": {
              "type": "object",
              "required": [
                "query"
              ],
              "properties": {
                "query": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "additionalProperties": false
            },
            "installMod": {
              "type": "object",
              "required": [
                "projectId"
              ],
              "properties": {
                "projectId": {
                  "type": "string",
                  "maxLength": 128
                },
                "title": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "additionalProperties": false
            },
            "updateMod": {
              "type": "object",
              "required": [
                "modId"
              ],
              "properties": {
                "modId": {
                  "type": "string",
                  "maxLength": 128
                },
                "title": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "additionalProperties": false
            },
            "runModAction": {
              "type": "object",
              "required": [
                "modId",
                "action"
              ],
              "properties": {
                "modId": {
                  "type": "string",
                  "maxLength": 128
                },
                "action": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "additionalProperties": false
            },
            "removeMod": {
              "type": "object",
              "required": [
                "modId"
              ],
              "properties": {
                "modId": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "additionalProperties": false
            },
            "setNewsRead": {
              "type": "object",
              "properties": {
                "ids": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  }
                },
                "read": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "results": {
          "type": "object",
          "required": [
            "diagnostics",
            "refresh",
            "refreshMod",
            "reloadSettings",
            "checkUpdates",
            "stageUpdate",
            "queueSystemUpdate",
            "selectUpdateQueueItems",
            "removeUpdateQueueItem",
            "startUpdateQueue",
            "clearUpdateQueue",
            "cancelUpdate",
            "restoreGamefiles",
            "captureGamefileOriginals",
            "searchCatalog",
            "installMod",
            "updateMod",
            "runModAction",
            "removeMod",
            "setNewsRead"
          ],
          "properties": {
            "diagnostics": {
              "$ref": "#/$defs/controlResult"
            },
            "refresh": {
              "$ref": "#/$defs/controlResult"
            },
            "refreshMod": {
              "$ref": "#/$defs/controlResult"
            },
            "reloadSettings": {
              "$ref": "#/$defs/controlResult"
            },
            "checkUpdates": {
              "$ref": "#/$defs/controlResult"
            },
            "stageUpdate": {
              "$ref": "#/$defs/controlResult"
            },
            "queueSystemUpdate": {
              "$ref": "#/$defs/controlResult"
            },
            "selectUpdateQueueItems": {
              "$ref": "#/$defs/controlResult"
            },
            "removeUpdateQueueItem": {
              "$ref": "#/$defs/controlResult"
            },
            "startUpdateQueue": {
              "$ref": "#/$defs/controlResult"
            },
            "clearUpdateQueue": {
              "$ref": "#/$defs/controlResult"
            },
            "cancelUpdate": {
              "$ref": "#/$defs/controlResult"
            },
            "restoreGamefiles": {
              "$ref": "#/$defs/controlResult"
            },
            "captureGamefileOriginals": {
              "$ref": "#/$defs/controlResult"
            },
            "searchCatalog": {
              "$ref": "#/$defs/controlResult"
            },
            "installMod": {
              "$ref": "#/$defs/controlResult"
            },
            "updateMod": {
              "$ref": "#/$defs/controlResult"
            },
            "runModAction": {
              "$ref": "#/$defs/controlResult"
            },
            "removeMod": {
              "$ref": "#/$defs/controlResult"
            },
            "setNewsRead": {
              "$ref": "#/$defs/controlResult"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "properties": {
        "mods": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "logs": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "cache": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "exports": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "updates": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "ui": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "runtime": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "modules": {
      "type": "object",
      "properties": {
        "modDetection": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "tolerateUnknownManifestFields": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "dllManager": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "excludedDllNames": {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "minLength": 1, "maxLength": 255 }
            },
            "profiles": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "required": ["id", "packageDirectory", "name", "target", "enabled", "approved", "files"],
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "packageDirectory": { "type": "string", "minLength": 1, "maxLength": 255 },
                  "name": { "type": "string", "minLength": 1, "maxLength": 160 },
                  "target": { "enum": ["client", "server", "both"] },
                  "enabled": { "type": "boolean" },
                  "approved": { "type": "boolean" },
                  "compatibilityProfile": { "type": ["string", "null"], "maxLength": 128 },
                  "files": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "required": ["path"],
                      "properties": {
                        "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\\\:]+\\.[dD][lL][lL]$" },
                        "mode": { "enum": ["library", "dinput8"] }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "debugConsole": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "popupMode": {
              "enum": [
                "bootstrap",
                "all",
                "errorsAndWarnings",
                "off"
              ]
            },
            "popupCooldownSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "defaultSource": {
              "enum": [
                "game",
                "loader",
                "diagnostics"
              ]
            },
            "levelFilter": {
              "enum": [
                "ALL",
                "TRACE",
                "DEBUG",
                "INFO",
                "WARN",
                "ERROR"
              ]
            },
            "autoScroll": {
              "type": "boolean"
            },
            "toggleKey": {
              "$ref": "#/$defs/keybind"
            },
            "refreshMilliseconds": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000
            },
            "tailBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 1048576
            },
            "window": {
              "type": "object",
              "properties": {
                "position": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": -100000,
                      "maximum": 100000
                    },
                    "y": {
                      "type": "integer",
                      "minimum": -100000,
                      "maximum": 100000
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "worldEditor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "toggleKey": {
              "$ref": "#/$defs/keybind"
            },
            "refreshMilliseconds": {
              "type": "integer",
              "minimum": 100,
              "maximum": 5000
            }
          },
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "serverSteamId": {
              "type": "string",
              "maxLength": 20,
              "pattern": "^$|^[0-9]{16,20}$"
            },
            "allowedClientSteamIds": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "additionalProperties": false
        },
        "modloaderUi": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "startPage": {
              "enum": [
                "activity",
                "news",
                "installed",
                "discover",
                "updates",
                "recycle-bin",
                "compatibility",
                "settings"
              ]
            },
            "toggleKey": {
              "$ref": "#/$defs/keybind"
            },
            "refreshMilliseconds": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000
            },
            "window": {
              "type": "object",
              "properties": {
                "position": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": -100000,
                      "maximum": 100000
                    },
                    "y": {
                      "type": "integer",
                      "minimum": -100000,
                      "maximum": 100000
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "runtimeDiagnostics": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "sessionActive": {
              "type": "boolean"
            },
            "continuous": {
              "type": "boolean"
            },
            "intervalMilliseconds": {
              "type": "integer",
              "minimum": 500,
              "maximum": 60000
            },
            "maximumDurationSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "slowCallbackMilliseconds": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 60000
            },
            "onlyChanges": {
              "type": "boolean"
            },
            "requestId": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "updates": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "window": {
              "type": "object",
              "properties": {
                "position": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": -100000,
                      "maximum": 100000
                    },
                    "y": {
                      "type": "integer",
                      "minimum": -100000,
                      "maximum": 100000
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "automatic": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "checkMinutes": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 1440
                },
                "queueUpdates": { "type": "boolean" }
              },
              "additionalProperties": false
            },
            "system": {
              "type": "object",
              "properties": {
                "includePrereleases": {
                  "type": "boolean"
                },
                "lastCheckAt": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "lastCheckAttemptAt": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "latestRelease": {
                  "$ref": "#/$defs/latestSystemRelease"
                },
                "startupPromptedVersion": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "additionalProperties": false
            },
            "mods": {
              "type": "object",
              "properties": {
                "lastCheckAt": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "latestUpdates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "projectId": { "type": "string" },
                      "modId": { "type": "string" },
                      "name": { "type": "string" },
                      "currentVersion": { "type": ["string", "null"] },
                      "latestVersion": { "type": ["string", "null"] },
                      "latestVersionId": { "type": "string" }
                    },
                    "required": ["projectId", "modId", "name", "latestVersionId"],
                    "additionalProperties": false
                  }
                },
                "lastCheckResult": {
                  "type": ["object", "null"],
                  "properties": {
                    "checked": { "type": "integer", "minimum": 0 },
                    "available": { "type": "integer", "minimum": 0 },
                    "failed": { "type": "integer", "minimum": 0 },
                    "checkedAt": { "type": "integer", "minimum": 0 },
                    "errors": { "type": "array", "items": { "type": "string" } }
                  },
                  "required": ["checked", "available", "failed", "checkedAt", "errors"],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "recycleBin": {
              "type": "object",
              "properties": {
                "automaticCleanup": {
                  "type": "boolean"
                },
                "retentionDays": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3650
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    "hotkeys": {
      "type": "object",
      "description": "Protected SDL scancodes. Edit this list in shroudforge/config/modloader-config.json. Active ShroudForge bindings remain defined by the existing module and mod settings.",
      "required": ["protectedKeys"],
      "properties": {
        "protectedKeys": {
          "type": "array",
          "description": "Use block to reject a key, confirm to ask before assignment, or cancel to keep the current binding and stop recording.",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["scancode", "label", "action"],
            "properties": {
              "scancode": { "type": "integer", "minimum": 1, "maximum": 999 },
              "label": { "type": "string", "minLength": 1, "maxLength": 32 },
              "action": { "enum": ["block", "confirm", "cancel"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "general": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"
        },
        "compactMode": {
          "type": "boolean"
        },
        "reducedMotion": {
          "type": "boolean"
        },
        "showNativeModMenu": {
          "type": "boolean"
        },
        "zoomPercent": {
          "type": "integer",
          "minimum": 70,
          "maximum": 150
        },
        "usernameMode": {
          "type": "string",
          "enum": ["auto", "manual"]
        },
        "messageNameFallback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "keybind": {
      "type": "string",
      "maxLength": 96,
      "description": "One shortcut string containing an SDL keyboard chord, a Mouse button chord, or keyboard|mouse alternatives. Each chord supports ordered Ctrl, Alt, Shift and Meta prefixes. Empty disables the shortcut.",
      "pattern": "^(?:(?:Ctrl\\+)?(?:Alt\\+)?(?:Shift\\+)?(?:Meta\\+)?SDL:[1-9][0-9]{0,2}(?:\\|(?:Ctrl\\+)?(?:Alt\\+)?(?:Shift\\+)?(?:Meta\\+)?Mouse:[1-9][0-9]?)?|(?:Ctrl\\+)?(?:Alt\\+)?(?:Shift\\+)?(?:Meta\\+)?Mouse:[1-9][0-9]?)?$"
    },
    "latestSystemRelease": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "version",
            "baseVersion",
            "build",
            "downloadUrl",
            "checksum",
            "releaseUrl",
            "message",
            "prerelease",
            "updateAvailable",
            "checkedAt"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "baseVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "build": {
              "type": "integer",
              "minimum": 0
            },
            "downloadUrl": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "checksum": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "releaseUrl": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2048
            },
            "message": {
              "type": "string",
              "maxLength": 20000
            },
            "prerelease": {
              "type": "boolean"
            },
            "mandatory": {
              "type": "boolean"
            },
            "repairRequired": {
              "type": "boolean"
            },
            "updateAvailable": {
              "type": "boolean"
            },
            "checkedAt": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "controlAction": {
      "type": "object",
      "required": [
        "execute",
        "payload",
        "requestId",
        "state",
        "result"
      ],
      "properties": {
        "execute": {
          "type": "boolean"
        },
        "payload": {
          "type": "object"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "state": {
          "enum": [
            "idle",
            "pending",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "result": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "unevaluatedProperties": false
    },
    "controlResult": {
      "type": "object",
      "required": [
        "requestId",
        "state",
        "result"
      ],
      "properties": {
        "requestId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "state": {
          "enum": [
            "idle",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "result": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    }
  }
}
