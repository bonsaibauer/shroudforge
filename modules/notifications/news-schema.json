{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "messages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "message"],
        "properties": {
          "title": {"type": "string"},
          "message": {"type": "string"},
          "beta": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "beta": { "type": "boolean" },
          "title": { "type": "string" },
          "message": { "type": "string" },
          "modId": { "type": "string" },
          "level": { "enum": ["trace", "debug", "info", "warn", "error"] },
          "updatedAt": { "type": "integer", "minimum": 0 },
          "repeatEveryDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
          "actionUrl": { "type": "string", "pattern": "^https://" },
          "actionLabelKey": { "type": "string", "maxLength": 120 },
          "links": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "oneOf": [
                { "required": ["url"], "not": { "required": ["wikiArticleId"] } },
                { "required": ["wikiArticleId"], "not": { "required": ["url"] } }
              ],
              "anyOf": [
                { "required": ["labelKey"] },
                { "required": ["label"] }
              ],
              "properties": {
                "labelKey": { "type": "string", "minLength": 1, "maxLength": 120 },
                "label": { "type": "string", "minLength": 1, "maxLength": 120 },
                "url": { "type": "string", "pattern": "^https://" },
                "wikiArticleId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 }
              },
              "additionalProperties": false
            }
          },
          "banner": {
            "type": "object",
            "required": ["imageUrl", "linkUrl", "alt"],
            "properties": {
              "imageUrl": { "type": "string", "pattern": "^https://" },
              "linkUrl": { "type": "string", "pattern": "^https://" },
              "alt": { "type": "string", "minLength": 1, "maxLength": 120 }
            },
            "additionalProperties": false
          },
          "actions": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["id", "kind"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 120 },
                "kind": { "const": "open-installed-mods" }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}
