{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "projects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projects": { "type": "object", "additionalProperties": { "type": "object" } },
    "packs": { "type": "object", "additionalProperties": {
      "type": "object",
      "required": ["versionId", "versionNumber", "mods"],
      "properties": {
        "packId": { "type": "string" },
        "versionId": { "type": "string", "minLength": 1 },
        "versionNumber": { "type": "string", "minLength": 1 },
        "selectedOptionalIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "mods": { "type": "array", "items": {
          "type": "object",
          "required": ["projectId", "versionId", "modId"],
          "properties": {
            "projectId": { "type": "string", "minLength": 1 },
            "versionId": { "type": "string", "minLength": 1 },
            "modId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        } }
      },
      "additionalProperties": false
    } }
  },
  "additionalProperties": false
}
