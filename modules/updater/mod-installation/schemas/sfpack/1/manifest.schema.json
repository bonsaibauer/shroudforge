{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shroudforge.net/schemas/sfpack/1/manifest.schema.json",
  "title": "ShroudForge Modpack v1",
  "description": "Manifest stored as shroudforge.index.json in a .sfpack ZIP. Only pinned ShroudEdit mod versions are supported. Archive and catalog checks described in format.txt are also mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "game", "name", "versionId", "gameVersions", "mods"],
  "properties": {
    "$schema": { "const": "https://shroudforge.net/schemas/sfpack/1/manifest.schema.json" },
    "formatVersion": { "const": 1 },
    "game": { "const": "enshrouded" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "versionId": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9._+\\-]+$" },
    "summary": { "type": "string", "maxLength": 2048 },
    "gameVersions": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._+\\-]+$" }
    },
    "mods": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": { "$ref": "#/$defs/mod" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 13, "pattern": "^[0-9A-Za-z]+$" },
    "mod": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "versionId", "sha512"],
      "properties": {
        "projectId": { "$ref": "#/$defs/id" },
        "versionId": { "$ref": "#/$defs/id" },
        "sha512": { "type": "string", "pattern": "^[a-f0-9]{128}$", "description": "SHA-512 of the exact published mod ZIP. It must match one file on the pinned version." }
      }
    }
  }
}
