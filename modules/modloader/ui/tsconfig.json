{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "react-markdown": ["./node_modules/react-markdown/index.d.ts"],
      "remark-gfm": ["./node_modules/remark-gfm/index.d.ts"],
      "@generated-flags": [
        "../../../build/ui/modloader-inputs/generated-flags.ts"
      ]
    }
  },
  "include": [
    "*.tsx",
    "ui-snapshot.ts",
    "*.ts",
    "vite-env.d.ts",
    "../../updater/ui/*.tsx",
    "../../runtime-diagnostics/ui/*.tsx",
    "../../notifications/ui/*.tsx",
    "../../notifications/ui/*.ts",
    "../../ui-resources/*.tsx",
    "../../ui-resources/*.ts",
    "../../logging/ui/*.tsx",
    "../../logging/ui/*.ts",
    "../../loader-config/ui/*.ts",
    "../../updater/ui/*.ts",
    "../../transport/ui/*.ts",
    "../../transport/ui/*.tsx",
    "../../debug-console/ui/settings.ts",
    "../../world-editor/ui/settings.ts",
    "../../loader-config/ui/*.tsx",
    "../../game-files/ui/*.tsx"
  ],
  "exclude": [
    "vite.config.ts"
  ]
}
