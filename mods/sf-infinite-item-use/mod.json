{
  "id": "sf-infinite-item-use",
  "name": "SF Infinite Item Use",
  "version": "1.0.0",
  "authors": [
    "bonsaibauer"
  ],
  "dependencies": [],
  "description": "Restores the typed inventory slot addressed by a Consume item action.",
  "enabled": true,
  "settings": {
    "excludedItemIds": ""
  },
  "shroudforge": {
    "schemaVersion": 1,
    "release": {
      "changelog": [
        "Added a declarative overview page for the Modloader UI.",
        "Added an item ID exclusion list."
      ]
    },
    "settingsSchema": {
      "type": "object",
      "properties": {
        "excludedItemIds": {
          "type": "string",
          "title": "Excluded item IDs",
          "default": "",
          "x-ui": {
            "key": "excludedItemIds",
            "type": "string",
            "control": "textarea",
            "label": "Excluded item IDs",
            "description": "Comma-separated or whitespace-separated numeric item IDs that may still be consumed.",
            "default": "",
            "group": "restoration",
            "maximumLength": 2000
          },
          "description": "Comma-separated or whitespace-separated numeric item IDs that may still be consumed.",
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    },
    "settingGroups": [
      {
        "id": "restoration",
        "label": "Restoration",
        "description": "Control when consumed items are restored."
      }
    ],
    "ui": {
      "sections": [
        {
          "title": "Infinite Item Use",
          "description": "Runtime behavior and scope",
          "components": [
            {
              "type": "setting",
              "key": "excludedItemIds"
            }
          ]
        }
      ]
    },
    "links": {
      "source-github": "https://github.com/bonsaibauer/shroudforge",
      "issues": "https://github.com/bonsaibauer/shroudforge/issues/new?template=bug_report.yml",
      "support-bmac": "https://buymeacoffee.com/bonsaibauer"
    }
  }
}
