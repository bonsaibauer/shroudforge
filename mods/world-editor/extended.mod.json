    },
    "targetX": {
      "value": 0,
      "label": "Target cell X"
    },
    "targetY": {
      "value": 0,
      "label": "Target cell Y"
    },
    "targetZ": {
      "value": 0,
      "label": "Target cell Z"
    },
    "targetWorldX": {
      "value": 0.0,
      "label": "Props-only target world X"
    },
    "targetWorldY": {
      "value": 0.0,
      "label": "Props-only target world Y"
    },
    "targetWorldZ": {
      "value": 0.0,
      "label": "Props-only target world Z"
    },
    "rotationQuarterTurns": {
      "value": 0,
      "min": 0,
      "max": 3,
          "label": "Initial paste rotation (F3 cycles in game, 0–3)"
    },
    "rotationAxis": {
      "value": "y",
      "options": {
