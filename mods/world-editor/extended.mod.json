{
  "$schema": "https://bonsaibauer.github.io/shroudforge/schemas/extended.mod.schema.json",
  "schemaVersion": 1,
  "enabled": true,
  "targets": [
    "client",
    "server"
  ],
  "links": {
    "source-github": "https://github.com/bonsaibauer/shroudforge",
    "issues": "https://github.com/bonsaibauer/shroudforge/issues/new?template=bug_report.yml",
    "support-bmac": "https://buymeacoffee.com/bonsaibauer"
  },
  "changelog": [
    "Discovers the current SteamID of a local Dedicated Server after every restart and reports unanswered P2P requests after 60 seconds with an explicit unknown-outcome warning.",
    "Persists the server-issued undo token across client restarts and automatically resumes it instead of losing the server's unresolved journal.",
    "Automatically selects local native writes or Dedicated Server Steam P2P from the validated live world context; pauses edits while that context is unknown.",
    "Makes the world target explicit: local/singleplayer stays on the direct client path; dedicated-server edits use Steam P2P.",
    "Routes multiplayer blueprint placement and undo over Steam P2P to the dedicated server's native world runtime; preserves direct singleplayer edits.",
    "Runs the same World Editor module headless on dedicated servers with an explicit SteamID64 allowlist and server-owned undo journal.",
    "Removes the experimental client game-input blueprint paste path; retains the existing SFBP V7 format and native direct planner.",
    "Moves rotated and scaled ItemInfo placement-bound filtering into the registered native world query.",
    "Preserves the native entity-template UUID through prop capture, blueprint files, and paste.",
    "Preserves captured prop scale with a dedicated verified native transform update.",
    "Adds V6 props-only blueprints and ShroudEdit-style world-space placement anchors with grid alignment checks.",
    "Uses registered native world APIs for entity handles, transform reads, safe handle-targeted removal, and voxel grid metadata.",
    "Packages the standalone mod as world-editor and exposes F3 rotation in Keyboard shortcuts.",
    "Adds a single F2-controlled blueprint window with a contextual instruction line, blueprint library, and screenshot-folder browser in blueprint management.",
    "Adds F3-F8 shortcuts, cursor-targeted paste, capture-to-blueprint workflow, rotation and paste modes, and conflict-checked undo. F1 remains available to the game."
  ],
  "settings": {
    "serverSteamId": {
      "value": "",
      "label": "Dedicated server SteamID64 fallback (remote server)"
    },
    "allowedClientSteamIds": {
      "value": "",
      "label": "Authorized client SteamID64 list (server; comma separated)"
    },
    "panelWidth": {
      "value": 1180,
      "min": 760,
      "max": 1920,
      "label": "Blueprint panel width"
    },
    "panelHeight": {
      "value": 190,
      "min": 140,
      "max": 400,
      "label": "Blueprint panel height"
    },
    "panelPositionX": {
      "value": -1,
      "min": -1,
      "max": 8192,
      "label": "Panel position X (−1 = centered)"
    },
    "panelPositionY": {
      "value": 92,
      "min": 0,
      "max": 8192,
      "label": "Panel position Y (from game top)"
    },
    "maximumCopyableProps": {
      "value": 60000,
      "min": 1,
      "max": 1000000,
      "label": "Maximum props per blueprint"
    },
    "sourceX": {
      "value": 0,
      "label": "Source cell X (manual fallback)"
    },
    "sourceY": {
      "value": 0,
      "label": "Source cell Y (manual fallback)"
    },
    "sourceZ": {
      "value": 0,
      "label": "Source cell Z (manual fallback)"
    },
    "sizeX": {
      "value": 8,
      "min": 1,
      "max": 65536,
      "label": "Size X (manual fallback)"
    },
    "sizeY": {
      "value": 8,
      "min": 1,
      "max": 65536,
      "label": "Size Y (manual fallback)"
    },
    "sizeZ": {
      "value": 8,
      "min": 1,
      "max": 65536,
      "label": "Size Z (manual fallback)"
    },
    "blueprintName": {
      "value": "my_blueprint",
      "minLength": 1,
      "maxLength": 64,
      "label": "Persistent blueprint name"
    },
    "blueprintNewName": {
      "value": "my_blueprint_copy",
      "minLength": 1,
      "maxLength": 64,
      "label": "New name for rename or duplicate"
    },
    "pasteVoxelMode": {
      "value": "replace",
      "options": {
        "replace": "Replace target voxels",
        "add": "Add occupied source voxels"
      },
      "label": "Voxel mode"
    },
    "targetPropMode": {
      "value": "keep",
      "options": {
        "keep": "Keep existing props",
        "replace": "Replace intersecting props"
      },
      "label": "Props at target"
    },
    "targetX": {
      "value": 0,
      "label": "Target cell X"
    },
    "targetY": {
      "value": 0,
      "label": "Target cell Y"
    },
    "targetZ": {
      "value": 0,
      "label": "Target cell Z"
    },
    "targetWorldX": {
      "value": 0.0,
      "label": "Props-only target world X"
    },
    "targetWorldY": {
      "value": 0.0,
      "label": "Props-only target world Y"
    },
    "targetWorldZ": {
      "value": 0.0,
      "label": "Props-only target world Z"
    },
    "rotationQuarterTurns": {
      "value": 0,
      "min": 0,
      "max": 3,
      "label": "Initial paste rotation (F3 cycles in game, 0–3)"
    },
    "rotationAxis": {
      "value": "y",
      "options": {
        "x": "X axis",
        "y": "Y axis",
        "z": "Z axis"
      },
      "label": "Blueprint up axis (stored on capture)"
    },
    "entityHandle": {
      "value": 0,
      "min": 0,
      "label": "Opaque entity handle"
    },
    "templateUuidHigh": {
      "value": "0000000000000000",
      "label": "Template UUID high (hex)"
    },
    "templateUuidLow": {
      "value": "0000000000000000",
      "label": "Template UUID low (hex)"
    },
    "trackingId": {
      "value": 0,
      "min": 0,
      "label": "Tracking ID"
    },
    "feedbackId": {
      "value": 0,
      "label": "Material feedback ID (placement only)"
    },
    "entityX": {
      "value": 0,
      "label": "Position X"
    },
    "entityY": {
      "value": 0,
      "label": "Position Y"
    },
    "entityZ": {
      "value": 0,
      "label": "Position Z"
    },
    "boundsMinX": {
      "value": 0,
      "label": "Bounds min X"
    },
    "boundsMinY": {
      "value": 0,
      "label": "Bounds min Y"
    },
    "boundsMinZ": {
      "value": 0,
      "label": "Bounds min Z"
    },
    "boundsMaxX": {
      "value": 0,
      "label": "Bounds max X"
    },
    "boundsMaxY": {
      "value": 0,
      "label": "Bounds max Y"
    },
    "boundsMaxZ": {
      "value": 0,
      "label": "Bounds max Z"
    }
  },
  "groups": [
    {
      "label": "In-game panel",
      "description": "Position is relative to the game window in logical pixels. X = −1 centers the panel; Y is measured down from the top. Changes apply while the game is running.",
      "settings": [
        "panelWidth",
        "panelHeight",
        "panelPositionX",
        "panelPositionY"
      ]
    },
    {
      "label": "World Editor limits",
      "settings": [
        "maximumCopyableProps"
      ]
    },
    {
      "label": "Keyboard shortcuts",
      "description": "Shortcuts work while the game window is focused.",
      "actions": [
        {
          "id": "rotateBlueprint",
          "label": "F3 — Rotate blueprint 90°",
          "style": "secondary"
        },
        {
          "id": "undoVoxels",
          "label": "F4 — Undo last paste",
          "style": "secondary"
        },
        {
          "id": "markCursorNext",
          "label": "F5 — Mark next selection corner",
          "style": "secondary"
        },
        {
          "id": "resetEditor",
          "label": "F6 — Reset editor",
          "style": "secondary",
          "confirm": "Clear the current selection, active blueprint, and undo history?"
        },
        {
          "id": "pasteAtCursor",
          "label": "F7 — Paste at cursor",
          "style": "danger",
          "confirm": "Write the active blueprint at the current cursor position?"
        },
        {
          "id": "captureAndSave",
          "label": "F8 — Capture and save blueprint",
          "style": "secondary"
        }
      ]
    },
    {
      "label": "Native entity operations",
      "description": "Spawn and placement use native game operations.",
      "settings": [
        "templateUuidHigh",
        "templateUuidLow",
        "trackingId",
        "entityX",
        "entityY",
        "entityZ",
        "feedbackId",
        "boundsMinX",
        "boundsMinY",
        "boundsMinZ",
        "boundsMaxX",
        "boundsMaxY",
        "boundsMaxZ"
      ],
      "actions": [
        {
          "id": "spawnEntity",
          "label": "Queue prop spawn",
          "style": "danger",
          "confirm": "Queue a native prop spawn using these UUID and tracking values?"
        },
        {
          "id": "placeEntity",
          "label": "Place at coordinates",
          "style": "danger",
          "confirm": "Dispatch native placement at these coordinates?"
        },
        {
          "id": "destroyEntity",
          "label": "Destroy at coordinates",
          "style": "danger",
          "confirm": "Dispatch native removal at these coordinates?"
        }
      ]
    },
    {
      "label": "World target and Server P2P",
      "description": "The client selects local native edits or Dedicated Server Steam P2P from the live world context. A local server SteamID is discovered automatically; serverSteamId is a fallback for remote servers. Authorize the client's SteamID64 on the server.",
      "settings": [
        "serverSteamId",
        "allowedClientSteamIds"
      ]
    },
    {
      "label": "World Editor",
      "description": "Capture voxel-and-prop or props-only blueprints, preview, paste, and undo through native world APIs.",
      "settings": [
        "sourceX",
        "sourceY",
        "sourceZ",
        "sizeX",
        "sizeY",
        "sizeZ",
        "blueprintName",
        "blueprintNewName",
        "rotationQuarterTurns",
        "rotationAxis",
        "pasteVoxelMode",
        "targetPropMode",
        "targetX",
        "targetY",
        "targetZ",
        "targetWorldX",
        "targetWorldY",
        "targetWorldZ",
        "entityHandle"
      ],
      "actions": [
        {
          "id": "markCursorA",
          "label": "Mark selection corner A",
          "style": "secondary"
        },
        {
          "id": "markCursorB",
          "label": "Mark selection corner B",
          "style": "secondary"
        },
        {
          "id": "markCursorTarget",
          "label": "Mark paste target",
          "style": "secondary"
        },
        {
          "id": "clearCursorSelection",
          "label": "Clear cursor marks",
          "style": "secondary"
        },
        {
          "id": "copyVoxels",
          "label": "Capture voxels and props",
          "style": "secondary"
        },
        {
          "id": "capturePropsOnly",
          "label": "Capture props only from A/B selection",
          "style": "secondary"
        },
        {
          "id": "listProps",
          "label": "List props in source region",
          "style": "secondary"
        },
        {
          "id": "resolveRecipes",
          "label": "Resolve build recipes",
          "style": "secondary"
        },
        {
          "id": "saveBlueprint",
          "label": "Save world blueprint",
          "style": "secondary"
        },
        {
          "id": "loadBlueprint",
          "label": "Load world blueprint",
          "style": "secondary"
        },
        {
          "id": "refreshBlueprintLibrary",
          "label": "Refresh blueprint folder",
          "style": "secondary"
        },
        {
          "id": "renameLibraryBlueprint",
