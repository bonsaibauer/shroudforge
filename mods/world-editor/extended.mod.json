{
  "$schema": "https://bonsaibauer.github.io/shroudforge/schemas/extended.mod.schema.json",
  "schemaVersion": 1,
  "enabled": true,
  "links": {
    "source-github": "https://github.com/bonsaibauer/shroudforge",
    "issues": "https://github.com/bonsaibauer/shroudforge/issues/new?template=bug_report.yml",
    "support-bmac": "https://buymeacoffee.com/bonsaibauer"
  },
  "changelog": [
    "Moves rotated and scaled ItemInfo placement-bound filtering into the registered native world query.",
    "Preserves the native entity-template UUID through prop capture, blueprint files, and paste.",
    "Preserves captured prop scale with a dedicated verified native transform update.",
    "Adds V6 props-only blueprints and ShroudEdit-style world-space placement anchors with grid alignment checks.",
    "Uses registered native world APIs for entity handles, transform reads, safe handle-targeted removal, and voxel grid metadata.",
    "Packages the standalone mod as world-editor and exposes F3 rotation in Keyboard shortcuts.",
    "Adds F3-F8 shortcuts, cursor-targeted paste, capture-to-blueprint workflow, rotation and paste modes, and conflict-checked undo."
  ],
  "settings": {
    "maximumCopyableProps": {
      "value": 60000,
      "min": 1,
      "max": 1000000,
      "label": "Maximum props per blueprint"
    },
    "sourceX": {
      "value": 0,
      "label": "Source cell X (manual fallback)"
    },
    "sourceY": {
      "value": 0,
      "label": "Source cell Y (manual fallback)"
    },
    "sourceZ": {
      "value": 0,
      "label": "Source cell Z (manual fallback)"
    },
    "sizeX": {
      "value": 8,
      "min": 1,
      "max": 65536,
      "label": "Size X (manual fallback)"
    },
    "sizeY": {
      "value": 8,
      "min": 1,
      "max": 65536,
      "label": "Size Y (manual fallback)"
    },
    "sizeZ": {
      "value": 8,
      "min": 1,
      "max": 65536,
      "label": "Size Z (manual fallback)"
    },
    "blueprintName": {
      "value": "my_blueprint",
      "minLength": 1,
      "maxLength": 64,
      "label": "Persistent blueprint name"
    },
    "pasteVoxelMode": {
      "value": "replace",
      "options": {
        "replace": "Replace target voxels",
        "add": "Add occupied source voxels"
      },
      "label": "Voxel mode"
    },
    "targetPropMode": {
      "value": "keep",
