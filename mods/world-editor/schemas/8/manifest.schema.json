{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shroudforge.net/schemas/sfbp/8/manifest.schema.json",
  "title": "ShroudForge blueprint 8",
  "description": "UTF-8 JSON stored in a .sfbp file. Semantic validation also checks cell counts, coverage, quaternion norms, nonzero UUIDs and available placement recipes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "rotationAxis", "extent", "props"],
  "properties": {
    "$schema": { "const": "https://shroudforge.net/schemas/sfbp/8/manifest.schema.json" },
    "formatVersion": { "const": 8 },
    "rotationAxis": { "enum": ["x", "y", "z"] },
    "extent": { "$ref": "#/$defs/extent" },
    "voxels": { "$ref": "#/$defs/voxels" },
    "props": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/prop" } }
  },
  "allOf": [{
    "if": { "not": { "required": ["voxels"] } },
    "then": { "properties": { "extent": { "items": { "exclusiveMinimum": 0 } } } }
  }],
  "$defs": {
    "vector": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "extent": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": 0 } },
    "hex": { "type": "string", "pattern": "^[0-9a-fA-F]{1,16}$" },
    "voxels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "offset", "cellSize", "cells", "coverage"],
      "properties": {
        "dimensions": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": 1, "maximum": 65536 } },
        "offset": { "$ref": "#/$defs/vector" },
        "cellSize": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "exclusiveMinimum": 0 } },
        "cells": { "type": "array", "minItems": 1, "maxItems": 65536, "items": { "type": "integer", "minimum": 0, "maximum": 65535 } },
        "coverage": { "type": "array", "minItems": 1, "maxItems": 65536, "items": { "type": "integer", "minimum": 0, "maximum": 2 } }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "position", "rotation", "scale", "templateUuidHighHex", "templateUuidLowHex"],
      "properties": {
        "itemId": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "position": { "$ref": "#/$defs/vector" },
        "rotation": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
        "scale": { "$ref": "#/$defs/vector" },
        "templateUuidHighHex": { "$ref": "#/$defs/hex" },
        "templateUuidLowHex": { "$ref": "#/$defs/hex" }
      }
    }
  }
}
