{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "api": {
      "type": "string",
      "description": "Required ShroudForge API version range."
    },
    "target": {
      "enum": [
        "client",
        "server",
        "both"
      ],
      "default": "both"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changelog": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
