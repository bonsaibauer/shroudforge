{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shroudforge.dev/schemas/mod.schema.json",
  "title": "ShroudForge mod package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "license": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "pattern": "^assets/[A-Za-z0-9._/-]+$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$",
            "maxLength": 80
          },
          "version": {
            "type": "string"
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "default": {}
    },
    "$schema": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "shroudforge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "changelog": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        },
        "links": {
          "$ref": "#/$defs/modLinks"
        },
        "settingsSchema": {
          "type": "object",
          "properties": {
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object"
            }
          },
          "required": [
            "type",
            "properties"
          ]
        },
        "settingGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/settingGroup"
          }
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      }
    }
  },
  "$defs": {
    "modLinks": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/httpsUrl" }
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "maxLength": 80
    },
    "settingGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "label",
        "default"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "boolean",
            "string",
            "integer",
            "number",
            "array"
          ]
        },
        "control": {
          "enum": [
            "toggle",
            "checkbox",
            "text",
            "textarea",
            "number",
            "slider",
            "select",
            "radio",
            "segmented",
            "multiselect",
            "keybind",
            "color"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "default": {},
        "group": {
          "$ref": "#/$defs/identifier"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimumLength": {
          "type": "integer",
          "minimum": 0
        },
        "maximumLength": {
          "type": "integer",
          "minimum": 1
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "setting",
            "text",
            "notice",
            "status",
            "button",
            "link",
            "separator",
            "image"
          ]
        },
        "key": {
          "$ref": "#/$defs/identifier"
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "level": {
          "enum": [
            "info",
            "success",
            "warning",
            "error"
          ]
        },
        "binding": {
          "$ref": "#/$defs/identifier"
        },
        "action": {
          "$ref": "#/$defs/identifier"
        },
        "style": {
          "enum": [
            "primary",
            "secondary",
            "danger"
          ]
        },
        "confirmation": {
          "type": "string",
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "src": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9._/-]+$"
        },
        "alt": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    },
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "sections"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tab"
          }
        }
      },
      "not": {
        "required": [
          "sections",
          "tabs"
        ]
      }
    }
  }
}
