{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "status", "target"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["preparing", "applied", "failed"] },
    "target": { "enum": ["enshrouded", "enshrouded_server"] },
    "phase": { "enum": ["prepare", "startup"] },
    "completedAt": { "type": "integer", "minimum": 0 },
    "error": { "type": "string", "minLength": 1 },
    "fingerprint": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "mods": { "type": "array", "items": { "type": "object", "required": ["id", "version"] } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "applied" } } },
      "then": { "required": ["phase", "completedAt", "mods", "fingerprint"] }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "required": ["phase", "completedAt", "error"] }
    }
  ]
}
