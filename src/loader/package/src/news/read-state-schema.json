{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["read", "readAt"],
  "properties": {
    "read": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "readAt": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
  },
  "additionalProperties": false
}
