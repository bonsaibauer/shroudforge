{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "messages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "message"],
        "properties": {
          "title": {"type": "string"},
          "message": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "title": { "type": "string" },
          "message": { "type": "string" },
          "modId": { "type": "string" },
          "level": { "enum": ["info", "warning", "error", "success", "update"] },
          "updatedAt": { "type": "integer", "minimum": 0 },
          "repeatEveryDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
          "actionUrl": { "type": "string", "pattern": "^https://" },
          "actionLabelKey": { "type": "string", "maxLength": 120 },
          "links": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["labelKey", "url"],
              "properties": {
                "labelKey": { "type": "string", "maxLength": 120 },
                "url": { "type": "string", "pattern": "^https://" }
              },
              "additionalProperties": false
            }
          },
          "actions": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["id", "kind"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 120 },
                "kind": { "const": "open-installed-mods" }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}
