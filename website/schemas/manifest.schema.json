{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bonsaibauer.github.io/shroudforge/schemas/manifest.schema.json",
  "title": "EML mod manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "license": {
      "description": "Optional license identifier (for example, MIT). Use null when no license is declared.",
      "type": [
        "string",
        "null"
      ]
    },
    "icon": {
      "description": "Optional mod icon filename in the package root or path under assets/. Use null when the mod has no icon.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:assets/[A-Za-z0-9._/-]+|[A-Za-z0-9_-][A-Za-z0-9._-]*)$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$",
            "maxLength": 80
          },
          "version": {
            "type": "string"
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "patch",
          "export",
          "runtime",
          "runtime-register-dll"
        ]
      }
    }
  }
}
